# Copier ce fichier en .env et ajuster les valeurs au besoin

# --- Notifications Email (SendGrid) ---
# Laisser vide ou 'stub' pour afficher les emails dans les logs du serveur (mode test/dev)
# Pour envoyer de vrais emails, créez une clé API gratuite sur https://sendgrid.com (100 emails/jour gratuit à vie)
SENDGRID_API_KEY=stub
SENDGRID_FROM_EMAIL=noreply@golfalert.ca

# --- Scraping ---
# false = interroge les vrais sites de golf en direct
# true = génère des créneaux simulés en cas d'indisponibilité
MOCK_SCRAPER=false

# --- Base de données (SQLite) ---
DB_PATH=./alerts.db

# --- Serveur FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000

